 "_Data/WorldMap/narration.bin": [
  {
   "jp": "かこのセカイからあつめられた、",
   "en": "The evil organizations, gathered"
  },
  {
   "jp": "あくのそしき……。",
   "en": "from the worlds of the past..."
  },
  {
   "jp": "ジェネラル・シャドウののこした",
   "en": "General Shadow spoke of"
  },
  {
   "jp": "ゲームということば……。",
   "en": "all of this as a \"game\"..."
  },
  {
   "jp": "このたたかいに、いったい",
   "en": "What could be the meaning"
  },
  {
   "jp": "なんの、いみがあるのか……。",
   "en": "behind this battle...?"
  },
  {
   "jp": "そのすべてに、こたえがだせぬまま",
   "en": "With none of their questions"
  },
  {
   "jp": "せんしたちは、まえへとすすむ。",
   "en": "answered, the warriors press on."
  },
  {
   "jp": "やみのなかで、たたかいをみまもる",
   "en": "Watching the battle from the dark"
  },
  {
   "jp": "おとこ……、ジュダ。",
   "en": "is one man... Juda."
  },
  {
   "jp": "カレにみちびかれるように、",
   "en": "As if led on by his hand,"
  },
  {
   "jp": "せんしたちは、おくへとすすむ。",
   "en": "the warriors venture deeper."
  },
  {
   "jp": "カレらをまちうける",
   "en": "What awaits them is"
  },
  {
   "jp": "あらたな、たたかいのぶたい、",
   "en": "a new stage of battle:"
  },
  {
   "jp": "ヨウガンのもえたぎる、",
   "en": "the scorching volcano zone,"
  },
  {
   "jp": "しゃくねつのかざんちたいへと…。",
   "en": "where molten lava boils..."
  },
  {
   "jp": "ライダーをあつめ、たおすことが",
   "en": "Gathering the Riders to destroy"
  },
  {
   "jp": "カレらのもくてきであった。",
   "en": "them - that was their true goal."
  },
  {
   "jp": "だが、それがわかったからといって",
   "en": "But even knowing that,"
  },
  {
   "jp": "このまま、のばなしにはできない。",
   "en": "the Riders cannot let it be."
  },
  {
   "jp": "ワナであることをしりながら、",
   "en": "Knowing full well it is a trap,"
  },
  {
   "jp": "せんしたちは、すすみつづける。",
   "en": "the warriors keep moving on,"
  },
  {
   "jp": "かこの、しゅくてきのまつ、",
   "en": "toward a new stage where"
  },
  {
   "jp": "あらたなステージへ……、",
   "en": "their old nemesis awaits..."
  },
  {
   "jp": "うつくしいオーロラがかかる、",
   "en": "into the snowfields beneath"
  },
  {
   "jp": "せつげんちたいへと…。",
   "en": "a beautiful aurora..."
  },
  {
   "jp": "せんしたちは、これまでの",
   "en": "The warriors looked back on"
  },
  {
   "jp": "みちのりをふりかえっていた……。",
   "en": "the long road behind them..."
  },
  {
   "jp": "たたかいをゲームとしょうし、",
   "en": "Juda calls this war a game,"
  },
  {
   "jp": "もてあそぶ、ジュダのやりかた。",
   "en": "toying with them for fun."
  },
  {
   "jp": "のぞまぬたたかいをしいられる、",
   "en": "Forced into a fight they never"
  },
  {
   "jp": "むなしさ……、やるせなさ……。",
   "en": "wanted... so empty, so bitter..."
  },
  {
   "jp": "そのいかりをちからへとかえ、",
   "en": "Turning that anger into power,"
  },
  {
   "jp": "けっせんのちへと、おもむく。",
   "en": "they head for the final battle,"
  },
  {
   "jp": "なぞのおとこ、ジュダのまつ、",
   "en": "to the enemy hideout where the"
  },
  {
   "jp": "てきのアジトへと……！",
   "en": "mysterious man, Juda, awaits...!"
  }
 ],
